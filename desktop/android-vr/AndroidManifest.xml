<?xml version="1.0" encoding="utf-8"?>
<!-- V.I.C.T.O.R. VR: liten app för Oculus Go (Android 7.1) och andra headset. Den öppnar V.I.C.T.O.R. i headsetets
     webbläsare, som har WebXR (en inbyggd webbvy saknar VR-stöd). Syns under "Okända källor" i biblioteket. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.noirlab.victor.vr">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="V.I.C.T.O.R. VR"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".Launch"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- V.I.C.T.O.R. startar headsetets spel och appar med länkar som victorvr://open?pkg=com.oculus.rooms -->
        <activity
            android:name=".Open"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="victorvr" android:host="open" />
            </intent-filter>
        </activity>
        <!-- liten tjänst på 127.0.0.1:8771 som startar headsetets spel åt V.I.C.T.O.R. -->
        <service android:name=".Bridge" android:exported="false" />
    </application>
</manifest>
